{
  "compilerOptions": {
    "module": "es2020",
    "target": "es2022",
    "lib": ["es2022", "dom"],
    "moduleResolution": "node",
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["webview/**/*.ts", "src/core/**/*.ts", "src/shared/panelProtocol.ts"]
}
