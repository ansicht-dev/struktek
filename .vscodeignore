# What NOT to ship in the .vsix.
#
# CRITICAL: vsce stops honouring .gitignore the moment this file exists, so
# anything gitignored still ships unless it is listed here. Check with
# `npx vsce ls` — `git status` cannot see into an ignored directory.
#
# Everything the extension needs at runtime is bundled by esbuild into
# out/extension.js, so no source and no node_modules are required.

src/**
webview/**
scripts/**
test-fixtures/**
node_modules/**
.vscode/**
.vscode-test/**
.github/**
.claude/**
dist-bridge/**

tsconfig*.json
vitest*.config.ts
esbuild.mjs
cliff.toml
*.vsix

# Repo hygiene that means nothing to an installed extension.
.gitignore
.gitattributes
SECURITY.md

# A developer's own agent config, pointing at absolute paths on their machine.
# It is untracked, and `vsce ls` is the only thing that would ever have told
# you it was riding along inside the .vsix.
.mcp.json

# Source maps are the easiest path back to readable source — never ship them.
out/**/*.map
**/*.map

# The bridge ships as an npm package launched via npx, not inside the .vsix.
out/mcp-bridge.js

# This repo's OWN template library — struktek uses struktek, but that library is
# dogfooding content, not product. Shipping it would drop someone else's
# templates into their .vsix. (The starter library users get is generated from
# src/host/seedContent.ts, not copied from here.)
.struktek/**
