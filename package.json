{
  "name": "struktek",
  "displayName": "Struktek",
  "description": "Never forget a good prompt. Compose reusable prompt templates with typed fields, and hand them to your agent.",
  "license": "SEE LICENSE IN LICENSE.txt",
  "keywords": [
    "prompt",
    "prompt engineering",
    "prompt template",
    "mcp",
    "model context protocol",
    "claude",
    "copilot",
    "codex",
    "ai",
    "agent"
  ],
  "version": "0.2.0",
  "publisher": "ansicht",
  "homepage": "https://ansicht.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/ansicht-dev/struktek.git"
  },
  "bugs": {
    "url": "https://github.com/ansicht-dev/struktek/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "icon": "assets/struktek.png",
  "galleryBanner": {
    "color": "#1B1B20",
    "theme": "dark"
  },
  "preview": true,
  "categories": [
    "AI",
    "Chat",
    "Snippets",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "struktek",
          "title": "Struktek",
          "icon": "assets/struktek-activitybar.svg"
        }
      ]
    },
    "views": {
      "struktek": [
        {
          "id": "struktek.sidebar",
          "name": "Struktek",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "struktek.open",
        "title": "Struktek: Open Panel",
        "icon": "$(window)"
      },
      {
        "command": "struktek.compose",
        "title": "Struktek: Compose Prompt",
        "icon": "$(play)"
      },
      {
        "command": "struktek.newTemplate",
        "title": "Struktek: New Template",
        "icon": "$(add)"
      },
      {
        "command": "struktek.newBlock",
        "title": "Struktek: New Block",
        "icon": "$(add)"
      },
      {
        "command": "struktek.openLibrary",
        "title": "Struktek: Open Template Library"
      },
      {
        "command": "struktek.openTemplate",
        "title": "Struktek: Open Template File",
        "icon": "$(go-to-file)"
      },
      {
        "command": "struktek.openBlock",
        "title": "Struktek: Open Block File"
      },
      {
        "command": "struktek.deleteTemplate",
        "title": "Struktek: Delete Template",
        "icon": "$(trash)"
      },
      {
        "command": "struktek.deleteBlock",
        "title": "Struktek: Delete Block",
        "icon": "$(trash)"
      },
      {
        "command": "struktek.deleteBlockType",
        "title": "Struktek: Delete Block Type",
        "icon": "$(trash)"
      },
      {
        "command": "struktek.refreshLibrary",
        "title": "Struktek: Refresh Library",
        "icon": "$(refresh)"
      },
      {
        "command": "struktek.seedLibrary",
        "title": "Struktek: Create Starter Templates"
      },
      {
        "command": "struktek.configureMcp",
        "title": "Struktek: Configure MCP for Agent",
        "icon": "$(plug)"
      },
      {
        "command": "struktek.restartMcp",
        "title": "Struktek: Restart MCP Server",
        "icon": "$(refresh)"
      },
      {
        "command": "struktek.mcpStatus",
        "title": "Struktek: MCP Server Status"
      },
      {
        "command": "struktek.showTemplate",
        "title": "Struktek: Open Template in Panel"
      },
      {
        "command": "struktek.makeGlobal",
        "title": "Struktek: Make Global",
        "icon": "$(globe)"
      },
      {
        "command": "struktek.makeWorkspace",
        "title": "Struktek: Make Workspace-Only",
        "icon": "$(root-folder)"
      },
      {
        "command": "struktek.openGlobalLibrary",
        "title": "Struktek: Reveal Global Library"
      },
      {
        "command": "struktek.reportIssue",
        "title": "Struktek: Report an Issue",
        "icon": "$(issues)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "struktek.open",
          "when": "view == struktek.sidebar",
          "group": "navigation@0"
        },
        {
          "command": "struktek.refreshLibrary",
          "when": "view == struktek.sidebar",
          "group": "navigation@1"
        },
        {
          "command": "struktek.configureMcp",
          "when": "view == struktek.sidebar",
          "group": "1_struktek@1"
        },
        {
          "command": "struktek.openGlobalLibrary",
          "when": "view == struktek.sidebar",
          "group": "1_struktek@2"
        },
        {
          "command": "struktek.reportIssue",
          "when": "view == struktek.sidebar",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "struktek.openTemplate",
          "when": "false"
        },
        {
          "command": "struktek.openBlock",
          "when": "false"
        },
        {
          "command": "struktek.showTemplate",
          "when": "false"
        },
        {
          "command": "struktek.deleteTemplate",
          "when": "false"
        },
        {
          "command": "struktek.deleteBlock",
          "when": "false"
        },
        {
          "command": "struktek.deleteBlockType",
          "when": "false"
        },
        {
          "command": "struktek.mcpStatus",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "struktek.compose",
        "key": "ctrl+shift+k",
        "mac": "cmd+shift+k"
      }
    ],
    "configuration": {
      "title": "Struktek",
      "properties": {
        "struktek.history.limit": {
          "type": "number",
          "default": 500,
          "minimum": 0,
          "maximum": 10000,
          "description": "How many generated prompts to keep per workspace. Set 0 to keep none. Stored in .struktek/.runtime, which is git-ignored. Reload the window to apply."
        },
        "struktek.libraryPath": {
          "type": "string",
          "default": ".struktek",
          "description": "Workspace-relative folder holding `templates/` and `blocks/`. Reload the window to apply."
        },
        "struktek.globalLibrary.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Also load a global library, visible from every workspace. A template of the same name in the workspace overrides the global one. Reload the window to apply."
        },
        "struktek.globalLibrary.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Where the global library lives. Empty means `~/.struktek`. Must be absolute or start with `~/` — a relative path has no project to be relative to. Reload the window to apply."
        },
        "struktek.logLevel": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ],
          "enumDescriptions": [
            "Everything, including per-parse detail.",
            "Normal operation.",
            "Problems that did not stop the operation.",
            "Failures only."
          ],
          "default": "info",
          "description": "Verbosity of the Struktek output channel. Takes effect immediately — no reload required."
        },
        "struktek.mcp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Run the MCP server so agents can list and compose your templates. Reload the window to apply."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "build:prod": "node esbuild.mjs --prod",
    "watch": "node esbuild.mjs --watch",
    "lint": "tsc --noEmit",
    "lint:tests": "tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npm run build:prod && npx --no-install @vscode/vsce package",
    "package:bridge": "node esbuild.mjs --prod && node scripts/build-bridge-package.mjs",
    "install:local": "node scripts/install-local.mjs",
    "lint:webview": "tsc -p tsconfig.webview.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "yaml": "^2.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.85.0",
    "@vscode/codicons": "^0.0.46-24",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.24.0",
    "ovsx": "^1.1.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
